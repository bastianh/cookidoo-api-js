{
  "name": "cookidoo-api-js",
  "version": "0.2.0",
  "description": "Unofficial JavaScript/TypeScript client to access Cookidoo.",
  "type": "module",
  "license": "MIT",
  "keywords": ["cookidoo", "vorwerk", "thermomix", "home-assistant", "iot"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.17"
  }
}
